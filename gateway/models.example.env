# Gavel gateway model configuration (example).
# Copy these as environment variables when starting gateway/gateway.mjs.

# Model every request tries first. TrueForge pins sessions to one model name;
# the gateway rewrites the first attempt to this model, then walks the chain.
GAVEL_PREFER=qwen/qwen3.8-27b

# Ordered fallback chain (comma-separated, provider/model on your provider).
GAVEL_CHAIN=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# Provider key is read from a local file, never from the repo or logs.
GROQ_KEY_FILE=/absolute/path/outside/the/repo/groq-key

# Ports / logs
PORT=8792
GAVEL_LOGS=/absolute/path/to/gavel/logs
